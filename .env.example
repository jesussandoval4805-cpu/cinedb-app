# Copia este archivo como .env solo si quieres probar localmente con la base en la nube.
# Cadena de conexión que da Neon (Connection string):
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.neon.tech/neondb?sslmode=require
# Texto largo y secreto para firmar la sesión (en Render se genera solo):
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Poner false para ocultar las credenciales de demostración en la pantalla de acceso:
SHOW_DEMO_HINT=true
